# --- Configuration de Bâtisseur (le pont) ---
# 1. Copiez ce fichier et renommez la copie en  .env
# 2. Renseignez votre clé API ci-dessous.
#
# Obtenez une clé API sur https://platform.claude.com
# (Console → Settings → API keys → Create key)

ANTHROPIC_API_KEY=colle-ta-cle-ici

# (Optionnel) Plusieurs clés, séparées par des virgules : l'app bascule automatiquement
# sur la suivante si l'une est saturée ou en erreur. Utile pour les sessions en direct.
# Laisser vide si tu n'as qu'une clé (ANTHROPIC_API_KEY ci-dessus suffit).
ANTHROPIC_API_KEYS=

# Modèle à utiliser. Liste à jour : https://platform.claude.com/docs/en/models/overview
# Exemples : claude-sonnet-5 (équilibré), claude-haiku-4-5-20251001 (le moins cher).
ANTHROPIC_MODEL=claude-sonnet-5

# (Optionnel) Modèle allégé pour les étapes de DISCUSSION (économie). La construction du
# site utilise toujours ANTHROPIC_MODEL. Par défaut = ANTHROPIC_MODEL (rien ne change).
# Ex. : ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_LIGHT=

# Port local (laisser tel quel si vous ne savez pas).
PORT=3000

# --- Publication en ligne (Palier 2, optionnel) ---
# Jeton d'accès Netlify : permet le bouton « Publier en ligne » dans l'app.
# La plateforme publie les sites des apprenants sous SON compte Netlify —
# l'apprenant n'a aucun compte à créer. Laissez vide pour désactiver le bouton.
# Obtenez un jeton sur https://app.netlify.com  →  User settings → Applications
#   → Personal access tokens → New access token.
NETLIFY_TOKEN=

# --- Base de données (Palier 3, optionnel) : mémoire durable ---
# Sans ces deux valeurs, l'app stocke tout en fichiers locaux (remis à zéro au redémarrage
# sur un hébergement gratuit). Avec Supabase, les conversations et les sites sont conservés.
# Créez un projet sur https://supabase.com, puis Project Settings → API :
#   SUPABASE_URL = l'URL du projet (ex. https://xxxx.supabase.co)
#   SUPABASE_KEY = la clé "service_role" (secrète, côté serveur uniquement)
# Créez aussi les deux tables (voir le README, section « Palier 3 »).
SUPABASE_URL=
SUPABASE_KEY=

# --- Comptes & espace membre (Palier 4) ---
# Aucune variable à ajouter ici : les comptes s'appuient sur la base Supabase déjà
# configurée ci-dessus (sinon sur un fichier local data/accounts.json). Si vous utilisez
# Supabase, créez les deux tables "users" et "sessions" (voir le README, section « Palier 4 »).
# Les mots de passe sont hachés (crypto.scrypt) ; la session est un cookie HttpOnly.

# --- Formateur / administrateur (gestion des apprenants) ---
# Adresse(s) email du/des formateur(s), séparées par des virgules. Ces comptes sont
# administrateurs : accès complet + bouton « Espace formateur » (inscrire des apprenants,
# attribuer les sessions, gérer les accès). Voir le README, section « Espace formateur ».
# Si vous utilisez Supabase, ajoutez aussi les colonnes status/cohort à la table users (README).
ADMIN_EMAILS=

# --- Envoi automatique des rappels e-mail (optionnel) ---
# Par défaut, les rappels de paiement sont proposés au formateur sous forme de liens
# prêts à envoyer (WhatsApp + e-mail). Pour envoyer les RAPPELS E-MAIL automatiquement,
# créez un compte gratuit sur Brevo (https://www.brevo.com, 300 e-mails/jour offerts),
# récupérez une clé API (SMTP & API → API Keys) et renseignez :
#   BREVO_API_KEY = la clé API Brevo
#   MAIL_FROM     = l'adresse expéditrice vérifiée dans Brevo (ex. contact@votredomaine.com)
#   MAIL_FROM_NAME= le nom affiché (facultatif, ex. Bâtisseur)
# Dès que ces variables sont présentes, les rappels e-mail partent tout seuls.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=
# Variante « webhook » (si vous avez votre propre service d'envoi) :
#   MAIL_WEBHOOK_URL = URL POST {to, subject, text}   (e-mail)
#   WA_WEBHOOK_URL   = URL POST {to, text}            (WhatsApp, si vous avez une passerelle)
MAIL_WEBHOOK_URL=
WA_WEBHOOK_URL=
