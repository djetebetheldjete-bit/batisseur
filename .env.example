# --- Configuration de Bâtisseur (le pont) ---
# 1. Copiez ce fichier et renommez la copie en  .env
# 2. Renseignez votre clé API ci-dessous.
#
# Obtenez une clé API sur https://platform.claude.com
# (Console → Settings → API keys → Create key)

ANTHROPIC_API_KEY=colle-ta-cle-ici

# Modèle à utiliser. Liste à jour : https://platform.claude.com/docs/en/models/overview
# Exemples : claude-sonnet-5 (équilibré), claude-haiku-4-5-20251001 (le moins cher).
ANTHROPIC_MODEL=claude-sonnet-5

# Port local (laisser tel quel si vous ne savez pas).
PORT=3000
